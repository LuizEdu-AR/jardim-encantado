rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function approved() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().status == 'approved';
    }

    function administrator() {
      return approved() && userData().role in ['admin', 'dev'];
    }

    function ownUserFieldsValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo'])
        && request.resource.data.name is string
        && request.resource.data.photo is string;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || administrator());
      allow list: if administrator();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['characterId', 'name', 'photo', 'role', 'status', 'createdAt'])
        && request.resource.data.role == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.characterId is string
        && request.resource.data.name is string
        && request.resource.data.photo is string
        && request.resource.data.characterId.matches('^[0-9]+$')
        && request.auth.token.email == request.resource.data.characterId + '@jardim-encantado.invalid';
      allow update: if signedIn() && request.auth.uid == uid && ownUserFieldsValid();
      allow delete: if false;
    }

    match /categories/{id} {
      allow read: if approved();
      allow create: if administrator()
        && request.resource.data.name is string
        && request.resource.data.color is string;
      allow update: if administrator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'color', 'updatedAt']);
      allow delete: if false;
    }

    match /students/{id} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.name is string
        && request.resource.data.characterId is string
        && request.resource.data.guardians is list;
      allow update: if approved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'characterId', 'photo', 'guardians', 'updatedAt']);
      allow delete: if approved();
    }

    match /activities/{id} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.date is string
        && request.resource.data.attendance is map;
      allow update: if approved() && userData().role in ['monitor', 'admin', 'dev']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'date', 'name', 'categoryId', 'responsible',
          'startTime', 'endTime', 'attendance', 'attendanceStatus',
          'attendanceRecordedByUid', 'attendanceRecordedByName', 'updatedAt'
        ]);
      allow delete: if administrator();
    }
  }
}
